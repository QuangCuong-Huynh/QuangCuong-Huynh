name: Collect Reports

on:
  workflow_dispatch:
  push:
    paths:
      - "projects-list.txt"   # trigger when key-value data file changes

jobs:
  collect:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Prepare reports directory
        run: mkdir -p reports

      - name: Parse key-value file & download READMEs
        shell: bash
        run: |
          while IFS='=' read -r name repo; do
            # skip empty lines or malformed lines
            [[ -z "$name" ]] && continue
            [[ "$name" =~ ^# ]] && continue

            echo "Processing: $name"
            echo "Repo URL: $repo"

            # convert to raw README URL
            raw_url="${repo/github.com/raw.githubusercontent.com}/docs/README.md"

            # download README
            curl -L "$raw_url" -o "reports/${name}.md" \
              || echo "Failed to download README for $name"

          done < projects.txt

      - name: Commit updated reports
        run: |
          git config --global user.name "auto-bot"
          git config --global user.email "bot@example.com"
          git fetch
          git add reports
          git commit -m "Auto update reports" || echo "No changes"
          git pull
          git push
